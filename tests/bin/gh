#!/bin/sh
# Fake `gh` CLI for tests (never the real one). Put tests/bin first on PATH.
#   REVUEY_FAKE_GH       scenario: ok (default), fail (exit 1), garbage (not JSON), ratelimit,
#                        errors (GraphQL errors and no data), slow (ok after
#                        $REVUEY_FAKE_GH_DELAY seconds, default 1), hang (sleeps 60s; its pid goes to
#                        $REVUEY_FAKE_GH_LOG.pid, as for every call)
#                        `gh repo set-default --view` answers from git config (gh-resolved),
#                        offline as gh does (only hang and slow apply to it)
#   REVUEY_FAKE_GH_LOG   file to append {argv, cwd} to (one JSON object per line)
#   REVUEY_FAKE_GH_PRS   JSON file: { "owner/name:branch": [PullRequest nodes, newest first] }
#                        answering the `gh api graphql` queries built by lua/revuey/forge.lua;
#                        `_parents` = { "me/shop": "acme/shop" } makes forks, `_null` = repos
#                        that resolve to null (partial data, exit 1); a node's `body` (the PR
#                        description) is only answered when the query's PR fragment asks for it
#   REVUEY_FAKE_GH_THREADS JSON file: { "owner/name#N": [PullRequestReviewThread nodes, each with
#                        `comments` a plain list] } answering forge.lua's review-thread queries
#                        page by page (`first`/`after`); `_null` = PRs that resolve to null,
#                        `_null_after` = PRs whose later pages come back null,
#                        `_heads` = the headRefOid each PR's thread pages report
#   REVUEY_FAKE_GH_THREADS_SCENARIO  fail | errors | fail_after (later pages only) for thread
#                        queries only
#   REVUEY_FAKE_GH_CHECK_SCENARIO  fail: the change check's queries fail (lookups still answer);
#                        the check is answered from the PRs and threads files (change them
#                        between checks to change a PR's signals)
#   REVUEY_FAKE_GH_CHECK_DELAY  seconds the change check's queries wait before answering
#   REVUEY_FAKE_GH_POST  JSON file: the GitHub side of posting a review (viewer, PRs with node ids,
#                        heads and pending reviews, REST PR files, review states, failures); it is
#                        also the fake's state: review mutations rewrite it (see fake_gh.lua)
#   REVUEY_FAKE_GH_MUTATIONS  file every mutation alias is appended to as {op, alias, input}
#   REVUEY_FAKE_GH_TREE_SCENARIO  fail: the stack tree's own rounds fail (the first, inside the
#                        PR lookup, answers); reject: a PR lookup carrying the tree's aliases is
#                        rejected with GraphQL errors (the lookup alone answers). The tree is
#                        answered from `_tree` in the PRs file (see fake_gh.lua)
#   REVUEY_FAKE_NVIM     nvim binary that runs the Lua half (default: nvim)
dir=$(cd "$(dirname "$0")" && pwd)
if [ "${REVUEY_FAKE_GH:-}" = hang ]; then
  # a gh that never answers; like the real one it dies on SIGTERM (exec: same pid)
  [ -n "${REVUEY_FAKE_GH_LOG:-}" ] && echo $$ > "$REVUEY_FAKE_GH_LOG.pid"
  exec sleep 60
fi
if [ "${REVUEY_FAKE_GH:-}" = slow ]; then
  sleep "${REVUEY_FAKE_GH_DELAY:-1}" # answers like ok, late
fi
exec "${REVUEY_FAKE_NVIM:-nvim}" --clean --headless -l "$dir/fake_gh.lua" "$@"
